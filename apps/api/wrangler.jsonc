{
  // The Worker serves /api/* and the static site in ../web/.dist. Run `npx wrangler d1 create go-game` once and paste its id below.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "go-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/.dist",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "go-game",
      "database_id": "0e83d3ca-fc9d-4310-abbd-0fda04c48c57",
      "migrations_dir": "migrations",
    },
  ],
  // At most 20 writes a minute for each player and each kind of write. namespace_id is any number that no other limiter of the account uses.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // One Durable Object per online game.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDo" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDo"] }],
  "vars": {
    "FIREBASE_PROJECT_ID": "go-game-c9ccd",
  },
}
