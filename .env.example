# Copy this file to .env to turn on player accounts and the leaderboard. Take the values from the Firebase console. They are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Optional. A reCAPTCHA v3 site key registered in Firebase App Check. Turn on enforcement in the console to block requests from other sites.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
# For development only. Points the app at the local Firebase Auth emulator (npm run firebase:auth-emulator). Use a project ID that starts with demo-.
VITE_FIREBASE_EMULATOR=

# The site key of a Cloudflare Turnstile widget (Turnstile > Add widget, type Managed or Invisible). It turns on the check before a nickname, a room or a join.
# The game server needs the matching secret: `npx wrangler secret put TURNSTILE_SECRET --config cloudflare/wrangler.jsonc`.
# For a try-out, 1x00000000000000000000AA is a key that always passes, and its secret is 1x0000000000000000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=

# A Google Analytics 4 ID (G-XXXXXXXXXX) turns on the cookie consent bar. Analytics loads only after the visitor says yes.
VITE_GA4_ID=

# For the game server in development only (npm run cloudflare:dev passes it on). It lets the server take the token "dev-<uid>"
# and the tokens of the Firebase Auth emulator. Never set it on a deployed Worker: it lets anyone sign in as anyone.
DEV_AUTH=1
